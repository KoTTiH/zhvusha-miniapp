# Скопируй в .env.local и заполни значения.
# .env.local уже в .gitignore — в git не попадёт.

# Ключ OpenRouter — для Жвуши, распознавания еды/дня, фото и транскрипции голоса.
# Модель задаётся централизованно в api/_lib/modelIds.ts.
OPENROUTER_API_KEY=...

# Необязательно — если хочешь проверять AI без валидации Telegram initData
# (например, из обычного браузера на localhost). В проде оставь пустым.
ALLOW_UNAUTH=1

# Токен бота — если хочешь жёстко валидировать запросы из Telegram даже в dev.
# В dev обычно не нужен (ALLOW_UNAUTH=1 пропускает проверку).
# TELEGRAM_BOT_TOKEN=123456789:AAE...

# Postgres для AI-разборов, платежей, дневника еды и заметок.
# В проде — Neon через Vercel Marketplace:
#   vercel integration add neon
# Локально — любой Postgres, например Docker:
#   docker run -d --name zh-pg -p 5432:5432 -e POSTGRES_PASSWORD=zh postgres:16
# После запуска — применить миграцию:
#   pnpm db:migrate
DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# Private Vercel Blob store для opt-in фото-дневника Жвуши.
# В проде создать Blob store с access=Private и подключить к проекту.
BLOB_READ_WRITE_TOKEN=

# Безлимит AI-кредитов для разработчиков.
# В env не кладём сырые Telegram id. Секрет храни только у себя, хэши генерируй локально:
#   node scripts/hash-developer-ids.mjs 123456789
DEVELOPER_ALLOWLIST_SECRET=
DEVELOPER_TELEGRAM_USER_ID_HASHES=

# Tribute digital products. Создать продукты в Tribute Dashboard и указать
# webhook URL: https://<domain>/api/tribute-webhook
TRIBUTE_API_KEY=
TRIBUTE_PRODUCT_30_ID=
TRIBUTE_PRODUCT_30_URL=
TRIBUTE_PRODUCT_100_ID=
TRIBUTE_PRODUCT_100_URL=
TRIBUTE_PRODUCT_300_ID=
TRIBUTE_PRODUCT_300_URL=
